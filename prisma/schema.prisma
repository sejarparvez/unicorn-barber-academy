// use prisma-next
//
// Integer autoincrement ids pair with better-auth's
// `advanced.database.generateId: "serial"` in src/lib/auth.ts (better-auth
// omits `id` on INSERT and the DB sequence fills it). Note: better-auth
// returns numeric ids as strings in its API responses.
// Schema originally generated by the better-auth CLI.

model User {
  id            Int                  @id @default(autoincrement())
  username      String?
  name          String?
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()
  // better-auth `admin` plugin fields (src/server/auth.ts)
  //
  // Academy roles — typed contract in src/lib/roles.ts:
  //   "user" | "student" | "instructor" | "admin"
  // Kept as plain text on purpose: better-auth owns writes to this table
  // and generates this schema. Do not convert to a Postgres enum without
  // also migrating better-auth's generated queries.
  role          String               @default("user")
  banned        Boolean              @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  blogPosts     BlogPost[]
  applications  EnrollmentApplication[]

  @@map("user")
}

model Session {
  id        Int                  @id @default(autoincrement())
  expiresAt DateTime
  token     String               @unique
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    Int
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int                   @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime              @default(now())
  updatedAt             temporal.updatedAt()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int                  @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Blog system (scripts/sql/001_blog.sql). Contract documentation only — the
// application's own pg pool (src/server/db.ts) owns these writes, same rule
// as the better-auth tables above. Column names match SQL exactly.
// ─────────────────────────────────────────────────────────────────────────────

model BlogCategory {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at")
  posts     BlogPost[]

  @@map("blog_category")
}

model BlogPost {
  id                  Int       @id @default(autoincrement())
  slug                String    @unique @db.VarChar(220)
  title               String    @db.VarChar(200)
  excerpt             String?   @db.VarChar(400)
  contentMd           String    @default("") @map("content_md")
  coverImageUrl       String?   @map("cover_image_url")
  coverImageAlt       String?   @map("cover_image_alt")
  // SEO block — public head() falls back to title/excerpt/cover when null.
  metaTitle           String?   @map("meta_title")
  metaDescription     String?   @map("meta_description")
  focusKeyword        String?   @map("focus_keyword")
  seoKeywords         String[]  @default([]) @map("seo_keywords")
  canonicalUrl        String?   @map("canonical_url")
  ogImageUrl          String?   @map("og_image_url")
  noindex             Boolean   @default(false)
  // AIO block — shaped for AI/LLM extraction.
  keyTakeaways        String[]  @default([]) @map("key_takeaways")
  faq                 Json      @default("[]") // [{ q: String, a: String }]
  relatedProgramSlugs String[]  @default([]) @map("related_program_slugs")
  tags                String[]  @default([])
  status              String    @default("draft") @db.VarChar(16) // draft | published | archived
  categoryId          Int?      @map("category_id")
  category            BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId            Int?      @map("author_id")
  author              User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  redirectsFrom       BlogSlugRedirect[]
  readingMinutes      Int       @default(1) @map("reading_minutes")
  publishedAt         DateTime? @map("published_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@map("blog_post")
}

// Old slug → live post. Maintained automatically on slug renames
// (src/server/blog-db.ts); lookups resolve chains in one hop by joining the
// post's CURRENT slug.
model BlogSlugRedirect {
  id        Int       @id @default(autoincrement())
  oldSlug   String    @unique @map("old_slug") @db.VarChar(220)
  postId    Int       @map("post_id")
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([postId])
  @@map("blog_slug_redirect")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enrollment system (scripts/sql/003_enrollment.sql). Same contract-only rule:
// writes go through the app's pg pool (src/server/enrollment-db.ts).
//
// program_slug references src/data/programs.ts by convention — the program
// catalog stays single-sourced in code, not duplicated in the DB.
// ─────────────────────────────────────────────────────────────────────────────

model ProgramIntake {
  id          Int      @id @default(autoincrement())
  programSlug String   @map("program_slug") @db.VarChar(120)
  cohort      String   @db.VarChar(16) // day | evening
  startsOn    DateTime @map("starts_on") @db.Date
  seatsTotal  Int      @default(12) @map("seats_total")
  isOpen      Boolean  @default(true) @map("is_open")
  createdAt   DateTime @default(now()) @map("created_at")
  applications EnrollmentApplication[]

  @@unique([programSlug, cohort, startsOn])
  @@index([programSlug, isOpen, startsOn])
  @@map("program_intake")
}

model EnrollmentApplication {
  id             Int           @id @default(autoincrement())
  reference      String        @unique @db.VarChar(20) // ENR-XXXXXX
  userId         Int           @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  intakeId       Int           @map("intake_id")
  intake         ProgramIntake @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  status         String        @default("pending") @db.VarChar(16) // pending|reviewing|approved|waitlisted|rejected
  fullName       String        @map("full_name") @db.VarChar(160)
  email          String        @db.VarChar(200)
  phone          String        @db.VarChar(40)
  experienceNote String?       @map("experience_note")
  hearAbout      String?       @map("hear_about") @db.VarChar(80)
  decidedAt      DateTime?     @map("decided_at")
  decidedBy      Int?          @map("decided_by")
  decisionNote   String?
  feeStatus      String        @default("unpaid") @map("fee_status") @db.VarChar(16) // unpaid | paid
  feePaidAt      DateTime?     @map("fee_paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@index([intakeId])
  @@map("enrollment_application")
}
