generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  enrollments Enrollment[]
  recordedPayments Payment[] @relation("PaymentRecordedBy")
  role        String?
  banned      Boolean?  @default(false)
  banReason   String?
  banExpires  DateTime?

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Program {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  level       String
  duration    String
  tagline     String
  description String
  highlights  String[]
  outcome     String
  whoFor      String[]
  careerPaths String[]
  price       Int
  position    Int
  featured    Boolean  @default(false)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules ProgramModule[]
  batches Batch[]

  @@index([category])
  @@index([position])
  @@map("program")
}

model ProgramModule {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String

  @@unique([programId, position])
  @@index([programId])
  @@map("program_module")
}

enum BatchStatus {
  upcoming
  running
  completed
  cancelled
}

enum EnrollmentStatus {
  applied
  waitlisted
  rejected
  active
  completed
  withdrawn
}

/// A cohort of a program, e.g. the morning or evening intake. Students apply
/// to a specific batch; seats are derived from its active enrollments.
model Batch {
  id        String      @id @default(cuid())
  programId String
  program   Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime?
  schedule  String
  capacity  Int
  status    BatchStatus @default(upcoming)
  hidden    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  enrollments Enrollment[]

  @@index([programId, status])
  @@map("batch")
}

/// A student's admission form and enrolment for one batch. `applied` is the
/// initial state; admins move it through waitlisted/rejected to active, then
/// completed or withdrawn. Unique per user and batch. The admission number and
/// date are assigned by an admin when the application is approved.
model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(applied)

  admissionNo String?  @unique
  admittedAt  DateTime?

  // 1. Student information
  fullName    String
  fatherName  String
  motherName  String
  dateOfBirth DateTime
  nationality String
  gender      String
  nidNumber   String

  // 2. Contact information
  phone            String
  whatsapp         String?
  presentAddress   String
  permanentAddress String

  // 3. Emergency contact
  emergencyName     String
  emergencyRelation String
  emergencyMobile   String
  emergencyAddress  String?

  // 4. Education & previous experience
  education                    String
  hasBarberingExperience       Boolean @default(false)
  barberingExperienceDuration  String?
  hasPreviousTraining          Boolean @default(false)
  previousTrainingInstitution  String?
  goal                         String

  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payments Payment[]

  @@unique([userId, batchId])
  @@index([batchId, status])
  @@index([userId])
  @@map("enrollment")
}

enum PaymentMethod {
  cash
  bkash
  nagad
  bank
  card
  other
}

/// A single payment received from a student against an enrolment. Payments are
/// recorded manually by admins; a student's balance is the program price minus
/// the sum of their recorded payments.
model Payment {
  id           String        @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Int
  method       PaymentMethod @default(cash)
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById String?
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([enrollmentId])
  @@index([paidAt])
  @@map("payment")
}
