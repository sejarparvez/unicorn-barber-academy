// use prisma-next
//
// Integer autoincrement ids pair with better-auth's
// `advanced.database.generateId: "serial"` in src/lib/auth.ts (better-auth
// omits `id` on INSERT and the DB sequence fills it). Note: better-auth
// returns numeric ids as strings in its API responses.
// Schema originally generated by the better-auth CLI.

model User {
  id            Int                  @id @default(autoincrement())
  username      String?
  name          String?
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()
  // better-auth `admin` plugin fields (src/server/auth.ts)
  //
  // Academy roles — typed contract in src/lib/roles.ts:
  //   "user" | "student" | "instructor" | "admin"
  // Kept as plain text on purpose: better-auth owns writes to this table
  // and generates this schema. Do not convert to a Postgres enum without
  // also migrating better-auth's generated queries.
  role          String               @default("user")
  banned        Boolean              @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        Int                  @id @default(autoincrement())
  expiresAt DateTime
  token     String               @unique
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    Int
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int                   @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime              @default(now())
  updatedAt             temporal.updatedAt()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int                  @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime             @default(now())
  updatedAt  temporal.updatedAt()

  @@index([identifier])
  @@map("verification")
}
