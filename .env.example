# Copy this file to `.env` and fill in real values.

# Connection string for PostgreSQL. Requires PostgreSQL >= 17.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign/session-hash auth tokens. Generate one with:
#   openssl rand -base64 32
# MUST be set in production; rotating it signs everyone out.
BETTER_AUTH_SECRET=""
# Absolute base URL of the app (no trailing slash path). Must match the origin
# visitors use — better-auth derives trusted origins and cookie flags from it.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID)
# Add these authorized redirect URIs to the OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   https://your-production-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email (verification + password reset) via resend.com.
# Without a key the app logs email links to the server console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Unicorn Barber Academy <onboarding@resend.dev>"

# Optional: PEM CA certificate for the database connection when system CAs are
# insufficient (e.g. custom proxy). Leave empty for normal Neon/Postgres usage.
DATABASE_SSL_CA=""

# Client-IP resolution for better-auth rate limiting + session records.
# REQUIRED behind a load balancer/CDN: without one of these, every request
# resolves to a single shared bucket and rate limits collapse globally.
# Either configure your proxy CIDRs (chain stripped right-to-left)…
TRUSTED_PROXIES=""
# …or point at a single-value header your platform sets (e.g. "x-real-ip",
# "cf-connecting-ip"). Multiple headers allowed, comma-separated, in priority
# order.
AUTH_IP_HEADERS=""

# ── Blog image uploads (S3-compatible object storage) ───────────────────────
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO — anything speaking
# the S3 API. Leave all four S3_* values empty to disable uploads; the editor
# shows a clear "not configured" message instead of failing mysteriously.
#   S3_ENDPOINT        — leave EMPTY for AWS proper. For R2:
#                        https://<account>.r2.cloudflarestorage.com
#   S3_REGION          — a real region for AWS (e.g. "us-east-1");
#                        "auto" works for R2/B2/MinIO.
#   S3_BUCKET          — bucket name. The bucket must allow public reads via
#                        S3_PUBLIC_BASE_URL (or serve it through a CDN).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL uploaded files are served from, no trailing slash.
# Example: https://cdn.example.com  or  https://pub-xxx.r2.dev
S3_PUBLIC_BASE_URL=""
