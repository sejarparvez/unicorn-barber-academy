# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 17.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID)
# Add these authorized redirect URIs to the OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   https://your-production-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
